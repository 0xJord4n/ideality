+let openTuiSessionPromise:
+  | Promise<typeof import("./runtime/open-tui-session.js")>
+  | undefined;
+
+function loadOpenTuiSession(): Promise<
+  typeof import("./runtime/open-tui-session.js")
+> {
+  openTuiSessionPromise ??= import("./runtime/open-tui-session.js");
+  return openTuiSessionPromise;
+}
+
+function createDeferredOpenTuiRendererSession(): OpenTuiRendererSession {
+  let resolved: OpenTuiRendererSession | undefined;
+  let resolving: Promise<OpenTuiRendererSession> | undefined;
+  const pending: Array<(session: OpenTuiRendererSession) => void> = [];
+  const resolveSession = (): Promise<OpenTuiRendererSession> => {
+    if (resolved) return Promise.resolve(resolved);
+    resolving ??= loadOpenTuiSession().then((runtime) => {
+      resolved = runtime.createOpenTuiRendererSession();
+      for (const operation of pending.splice(0)) operation(resolved);
+      return resolved;
+    });
+    return resolving;
+  };
+  const defer = (operation: (session: OpenTuiRendererSession) => void) => {
+    if (resolved) operation(resolved);
+    else {
+      pending.push(operation);
+      void resolveSession();
+    }
+  };
+
+  return {
+    initialize: async () => (await resolveSession()).initialize(),
+    runPrompt: async (args) => (await resolveSession()).runPrompt(args),
+    appendHistoryLines: (lines) =>
+      defer((session) => session.appendHistoryLines(lines)),
+    setHistorySection: (key, lines) =>
+      defer((session) => session.setHistorySection(key, lines)),
+    renderStatusLine: (content, fg) =>
+      defer((session) => session.renderStatusLine(content, fg)),
+    clearStatusLine: () => defer((session) => session.clearStatusLine()),
+    flushHistoryToStdout: () =>
+      defer((session) => session.flushHistoryToStdout()),
+    dispose: async () => {
+      if (resolved || pending.length > 0) await (await resolveSession()).dispose();
+    },
+  };
+}
 
