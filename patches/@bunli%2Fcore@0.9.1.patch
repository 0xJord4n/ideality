+function createDeferredPromptSession(): PromptSession {
+  let session: PromptSession | undefined;
+  const resolveSession = (): PromptSession => {
+    if (!session) {
+      session = createPromptSession();
+    }
+    return session;
+  };
+
+  const prompt = new Proxy(
+    ((...args: Parameters<PromptSession["prompt"]>) =>
+      resolveSession().prompt(...args)) as PromptSession["prompt"],
+    {
+      get(_target, property) {
+        const resolvedPrompt = resolveSession().prompt;
+        const value = Reflect.get(resolvedPrompt, property);
+        return typeof value === "function" ? value.bind(resolvedPrompt) : value;
+      },
+    },
+  );
+
+  return {
+    initialize: () => resolveSession().initialize(),
+    prompt,
+    spinner: (...args) => resolveSession().spinner(...args),
+    dispose: () => session?.dispose() ?? Promise.resolve(),
+  };
+}
+
+const runDeferredTuiRender: typeof runTuiRender = async (args) => {
+  const tuiRuntime = await import("./runtime/tui-render.js");
+  await tuiRuntime.runTuiRender(args);
+};
