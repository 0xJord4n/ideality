// Dashlane - reviewed privileged adapter contribution manifest.
{
  "schemaVersion": 1,
  "kind": "privileged-adapter",
  "adapterKind": "secret",
  "id": "dashlane",
  "displayName": "Dashlane",
  "description": "Dashlane CLI read-only reference backend",
  "capability": {
    "name": "secret-backend",
    "operations": ["read"]
  },
  "platforms": {
    "os": ["any"],
    "arch": ["any"],
    "executables": ["dcli"]
  },
  "permissions": {
    "privileges": ["read-only-secret-store", "external-cli"],
    "filesystem": [],
    "network": [],
    "secrets": ["read"]
  },
  "implementation": {
    "type": "trusted-core"
  },
  "provenance": {
    "repository": "https://github.com/0xJord4n/ideality",
    "license": "MIT",
    "maintainers": ["0xJord4n@users.noreply.github.com"]
  },
  "signing": {
    "mode": "release-bundle",
    "identity": "https://github.com/0xJord4n/ideality/.github/workflows/release.yml@refs/tags/v*",
    "issuer": "https://token.actions.githubusercontent.com"
  }
}
