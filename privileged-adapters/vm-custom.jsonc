// Custom VM - reviewed privileged adapter contribution manifest.
{
  "schemaVersion": 1,
  "kind": "privileged-adapter",
  "adapterKind": "vm",
  "id": "custom",
  "displayName": "Custom VM",
  "description": "User-configured argv-only VM lifecycle",
  "capability": {
    "name": "vm-lifecycle",
    "operations": ["start", "stop", "status", "exec"]
  },
  "platforms": {
    "os": ["any"],
    "arch": ["any"],
    "executables": []
  },
  "permissions": {
    "privileges": ["custom-command"],
    "filesystem": ["config-write", "runtime-state"],
    "network": ["guest-control"],
    "secrets": []
  },
  "implementation": {
    "type": "user-configured"
  },
  "provenance": {
    "repository": "https://github.com/0xJord4n/ideality",
    "license": "MIT",
    "maintainers": ["0xJord4n@users.noreply.github.com"]
  },
  "signing": {
    "mode": "release-bundle",
    "identity": "https://github.com/0xJord4n/ideality/.github/workflows/release.yml@refs/tags/v*",
    "issuer": "https://token.actions.githubusercontent.com"
  }
}
