// age - reviewed privileged adapter contribution manifest.
{
  "schemaVersion": 1,
  "kind": "privileged-adapter",
  "adapterKind": "secret",
  "id": "age",
  "displayName": "age",
  "description": "age-encrypted file secret backend",
  "capability": {
    "name": "secret-backend",
    "operations": ["read", "write", "list", "delete"]
  },
  "platforms": {
    "os": ["any"],
    "arch": ["any"],
    "executables": ["age"]
  },
  "permissions": {
    "privileges": ["secret-store", "external-cli"],
    "filesystem": ["secret-read", "secret-write"],
    "network": [],
    "secrets": ["read", "write", "list", "delete"]
  },
  "implementation": {
    "type": "trusted-core"
  },
  "provenance": {
    "repository": "https://github.com/0xJord4n/ideality",
    "license": "MIT",
    "maintainers": ["0xJord4n@users.noreply.github.com"]
  },
  "signing": {
    "mode": "release-bundle",
    "identity": "https://github.com/0xJord4n/ideality/.github/workflows/release.yml@refs/tags/v*",
    "issuer": "https://token.actions.githubusercontent.com"
  }
}
