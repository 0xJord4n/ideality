// age - deterministic privileged behavior contract.
{
  "contractVersion": 1,
  "kind": "privileged-adapter-contract",
  "adapterKind": "secret",
  "adapter": "age",
  "cases": [
    {
      "case": "linux",
      "platform": "linux",
      "config": {
        "type": "age",
        "recipient": "age1contract",
        "identityFile": "~/.config/age/key.txt"
      },
      "expected": {
        "executable": "age",
        "writable": true,
        "operations": {
          "write": {
            "key": "contract/token",
            "value": "contract-secret",
            "calls": [
              {
                "command": ["age", "--encrypt", "-r", "age1contract"],
                "input": "contract-secret\n"
              }
            ]
          },
          "read": {
            "key": "contract/token",
            "result": "contract-secret",
            "calls": [
              {
                "command": [
                  "age",
                  "--decrypt",
                  "-i",
                  "{{home}}/.config/age/key.txt",
                  "{{idealityHome}}/secrets/contract/token.age"
                ]
              }
            ]
          },
          "list": {
            "result": {
              "backend": "age",
              "supported": true,
              "writable": true,
              "references": ["contract/token"]
            },
            "calls": []
          },
          "delete": {
            "key": "contract/token",
            "calls": []
          }
        }
      }
    }
  ]
}
