// Dashlane - deterministic privileged behavior contract.
{
  "contractVersion": 1,
  "kind": "privileged-adapter-contract",
  "adapterKind": "secret",
  "adapter": "dashlane",
  "cases": [
    {
      "case": "linux",
      "platform": "linux",
      "config": {
        "type": "dashlane"
      },
      "expected": {
        "executable": "dcli",
        "writable": false,
        "operations": {
          "read": {
            "key": "dl://secret-id/value",
            "result": "contract-secret",
            "calls": [
              {
                "command": ["dcli", "read", "dl://secret-id/value"]
              }
            ]
          }
        }
      }
    }
  ]
}
