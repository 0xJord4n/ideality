// OS keychain - deterministic privileged behavior contract.
{
  "contractVersion": 1,
  "kind": "privileged-adapter-contract",
  "adapterKind": "secret",
  "adapter": "keychain",
  "cases": [
    {
      "case": "linux",
      "platform": "linux",
      "config": {
        "type": "keychain"
      },
      "expected": {
        "executable": "secret-tool",
        "writable": true,
        "operations": {
          "write": {
            "key": "contract/token",
            "value": "contract-secret",
            "calls": [
              {
                "command": [
                  "secret-tool",
                  "store",
                  "--label",
                  "Ideality contract/token",
                  "service",
                  "ideality",
                  "key",
                  "contract/token"
                ],
                "input": "contract-secret\n"
              }
            ]
          },
          "read": {
            "key": "contract/token",
            "result": "contract-secret",
            "calls": [
              {
                "command": [
                  "secret-tool",
                  "lookup",
                  "service",
                  "ideality",
                  "key",
                  "contract/token"
                ]
              }
            ]
          },
          "delete": {
            "key": "contract/token",
            "calls": [
              {
                "command": [
                  "secret-tool",
                  "clear",
                  "service",
                  "ideality",
                  "key",
                  "contract/token"
                ]
              }
            ]
          }
        }
      }
    },
    {
      "case": "darwin",
      "platform": "darwin",
      "config": {
        "type": "keychain"
      },
      "expected": {
        "executable": "security",
        "writable": false,
        "operations": {
          "write": {
            "key": "contract/token",
            "value": "contract-secret",
            "error": "Keychain writes are disabled on macOS because the security CLI exposes values in process arguments; use age, pass, or 1Password",
            "calls": []
          },
          "read": {
            "key": "contract/token",
            "result": "contract-secret",
            "calls": [
              {
                "command": [
                  "security",
                  "find-generic-password",
                  "-s",
                  "ideality",
                  "-a",
                  "contract/token",
                  "-w"
                ]
              }
            ]
          },
          "delete": {
            "key": "contract/token",
            "error": "keychain references are read-only; delete the item with its native app or CLI",
            "calls": []
          }
        }
      }
    }
  ]
}
