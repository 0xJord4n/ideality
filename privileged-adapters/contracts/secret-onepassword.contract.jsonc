// 1Password - deterministic privileged behavior contract.
{
  "contractVersion": 1,
  "kind": "privileged-adapter-contract",
  "adapterKind": "secret",
  "adapter": "onepassword",
  "cases": [
    {
      "case": "linux",
      "platform": "linux",
      "config": {
        "type": "onepassword"
      },
      "expected": {
        "executable": "op",
        "writable": false,
        "operations": {
          "read": {
            "key": "op://Contract/token",
            "result": "contract-secret",
            "calls": [
              {
                "command": ["op", "read", "op://Contract/token"]
              }
            ]
          }
        }
      }
    }
  ]
}
