// Bitwarden - deterministic privileged behavior contract.
{
  "contractVersion": 1,
  "kind": "privileged-adapter-contract",
  "adapterKind": "secret",
  "adapter": "bitwarden",
  "cases": [
    {
      "case": "linux",
      "platform": "linux",
      "config": {
        "type": "bitwarden",
        "appDataDirectory": "~/.config/bitwarden-contract"
      },
      "expected": {
        "executable": "bw",
        "writable": false,
        "operations": {
          "read": {
            "key": "bw://item-id",
            "result": "contract-secret",
            "calls": [
              {
                "command": ["bw", "get", "password", "item-id"],
                "environment": {
                  "BITWARDENCLI_APPDATA_DIR": "{{home}}/.config/bitwarden-contract"
                }
              }
            ]
          }
        }
      }
    }
  ]
}
