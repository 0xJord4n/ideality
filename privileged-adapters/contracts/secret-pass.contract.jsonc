// pass - deterministic privileged behavior contract.
{
  "contractVersion": 1,
  "kind": "privileged-adapter-contract",
  "adapterKind": "secret",
  "adapter": "pass",
  "cases": [
    {
      "case": "linux",
      "platform": "linux",
      "config": {
        "type": "pass"
      },
      "expected": {
        "executable": "pass",
        "writable": true,
        "operations": {
          "write": {
            "key": "contract/token",
            "value": "contract-secret",
            "calls": [
              {
                "command": [
                  "pass",
                  "insert",
                  "--multiline",
                  "--force",
                  "ideality/contract/token"
                ],
                "input": "contract-secret\n"
              }
            ]
          },
          "read": {
            "key": "contract/token",
            "result": "contract-secret",
            "calls": [
              {
                "command": ["pass", "show", "ideality/contract/token"]
              }
            ]
          },
          "delete": {
            "key": "contract/token",
            "calls": [
              {
                "command": ["pass", "rm", "--force", "ideality/contract/token"]
              }
            ]
          }
        }
      }
    }
  ]
}
