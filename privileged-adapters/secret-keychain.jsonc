// OS keychain - reviewed privileged adapter contribution manifest.
{
  "schemaVersion": 1,
  "kind": "privileged-adapter",
  "adapterKind": "secret",
  "id": "keychain",
  "displayName": "OS keychain",
  "description": "macOS Keychain or libsecret backend",
  "capability": {
    "name": "secret-backend",
    "operations": ["read", "write", "delete"]
  },
  "platforms": {
    "os": ["linux", "darwin"],
    "arch": ["any"],
    "executables": ["security", "secret-tool"]
  },
  "permissions": {
    "privileges": ["secret-store"],
    "filesystem": [],
    "network": [],
    "secrets": ["read", "write", "delete"]
  },
  "implementation": {
    "type": "trusted-core"
  },
  "provenance": {
    "repository": "https://github.com/0xJord4n/ideality",
    "license": "MIT",
    "maintainers": ["0xJord4n@users.noreply.github.com"]
  },
  "signing": {
    "mode": "release-bundle",
    "identity": "https://github.com/0xJord4n/ideality/.github/workflows/release.yml@refs/tags/v*",
    "issuer": "https://token.actions.githubusercontent.com"
  }
}
