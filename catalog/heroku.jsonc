// Heroku CLI - built-in tool adapter manifest.
{
  "schemaVersion": 1,
  "kind": "tool",
  "id": "heroku",
  "displayName": "Heroku CLI",
  "pack": "deployment",
  "executable": {
    "primary": "heroku"
  },
  "isolation": {
    "scope": "process",
    "state": "credentials"
  },
  "auth": {
    "login": [
      "login"
    ],
    "status": [
      "auth:whoami"
    ],
    "logout": [
      "logout"
    ]
  },
  "profile": {
    "env": {
      "HEROKU_API_KEY": {
        "from": "secret",
        "key": "{{identity}}/heroku-token",
        "optional": true
      },
      "XDG_CONFIG_HOME": "{{idealityHome}}/profiles/{{identity}}/deployment/heroku/config",
      "XDG_DATA_HOME": "{{idealityHome}}/profiles/{{identity}}/deployment/heroku/data",
      "XDG_STATE_HOME": "{{idealityHome}}/profiles/{{identity}}/deployment/heroku/state",
      "XDG_CACHE_HOME": "{{idealityHome}}/profiles/{{identity}}/deployment/heroku/cache"
    }
  }
}
