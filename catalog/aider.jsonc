// Aider - built-in tool adapter manifest.
{
  "schemaVersion": 1,
  "kind": "tool",
  "id": "aider",
  "displayName": "Aider",
  "pack": "ai",
  "executable": {
    "primary": "aider"
  },
  "isolation": {
    "scope": "process",
    "state": "credentials"
  },
  "profile": {
    "env": {
      "OPENAI_API_KEY": {
        "from": "secret",
        "key": "{{identity}}/openai-api-key",
        "optional": true
      },
      "ANTHROPIC_API_KEY": {
        "from": "secret",
        "key": "{{identity}}/anthropic-api-key",
        "optional": true
      }
    }
  }
}
