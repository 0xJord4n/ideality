// Amp - built-in tool adapter manifest.
{
  "schemaVersion": 1,
  "kind": "tool",
  "id": "amp",
  "displayName": "Amp",
  "pack": "ai",
  "executable": {
    "primary": "amp"
  },
  "isolation": {
    "scope": "process",
    "state": "full"
  },
  "profile": {
    "env": {
      "XDG_CONFIG_HOME": "{{idealityHome}}/profiles/{{identity}}/ai/amp/config",
      "XDG_DATA_HOME": "{{idealityHome}}/profiles/{{identity}}/ai/amp/data",
      "XDG_STATE_HOME": "{{idealityHome}}/profiles/{{identity}}/ai/amp/state",
      "XDG_CACHE_HOME": "{{idealityHome}}/profiles/{{identity}}/ai/amp/cache",
      "AMP_API_KEY": {
        "from": "secret",
        "key": "{{identity}}/amp-api-key",
        "optional": true
      }
    }
  }
}
