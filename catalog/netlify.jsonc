// Netlify CLI - built-in tool adapter manifest.
{
  "schemaVersion": 1,
  "kind": "tool",
  "id": "netlify",
  "displayName": "Netlify CLI",
  "pack": "deployment",
  "executable": {
    "primary": "netlify"
  },
  "isolation": {
    "scope": "process",
    "state": "full"
  },
  "auth": {
    "login": [
      "login"
    ],
    "status": [
      "status"
    ],
    "logout": [
      "logout"
    ]
  },
  "profile": {
    "env": {
      "NETLIFY_AUTH_TOKEN": {
        "from": "secret",
        "key": "{{identity}}/netlify-token",
        "optional": true
      },
      "XDG_CONFIG_HOME": "{{idealityHome}}/profiles/{{identity}}/deployment/netlify/config",
      "XDG_DATA_HOME": "{{idealityHome}}/profiles/{{identity}}/deployment/netlify/data",
      "XDG_STATE_HOME": "{{idealityHome}}/profiles/{{identity}}/deployment/netlify/state",
      "XDG_CACHE_HOME": "{{idealityHome}}/profiles/{{identity}}/deployment/netlify/cache"
    }
  }
}
