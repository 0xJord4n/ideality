// Bitbucket community CLI - built-in tool adapter manifest.
{
  "schemaVersion": 1,
  "kind": "tool",
  "id": "bitbucket",
  "displayName": "Bitbucket community CLI",
  "pack": "source-control",
  "executable": {
    "primary": "bitbucket",
    "alternatives": [
      "bb"
    ]
  },
  "isolation": {
    "scope": "process",
    "state": "credentials"
  },
  "profile": {
    "env": {
      "XDG_CONFIG_HOME": "{{idealityHome}}/profiles/{{identity}}/source-control/bitbucket/config",
      "XDG_DATA_HOME": "{{idealityHome}}/profiles/{{identity}}/source-control/bitbucket/data",
      "XDG_STATE_HOME": "{{idealityHome}}/profiles/{{identity}}/source-control/bitbucket/state",
      "XDG_CACHE_HOME": "{{idealityHome}}/profiles/{{identity}}/source-control/bitbucket/cache",
      "BITBUCKET_TOKEN": {
        "from": "secret",
        "key": "{{identity}}/bitbucket-token",
        "optional": true
      }
    }
  }
}
