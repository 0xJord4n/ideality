// Claude Code - built-in tool adapter manifest.
{
  "schemaVersion": 1,
  "kind": "tool",
  "id": "claude",
  "displayName": "Claude Code",
  "pack": "essentials",
  "executable": {
    "primary": "claude"
  },
  "isolation": {
    "scope": "process",
    "state": "full"
  },
  "auth": {
    "login": [
      "auth",
      "login"
    ],
    "status": [
      "auth",
      "status"
    ],
    "logout": [
      "auth",
      "logout"
    ]
  },
  "profile": {
    "env": {
      "CLAUDE_CONFIG_DIR": "{{idealityHome}}/profiles/{{identity}}/claude"
    }
  }
}
