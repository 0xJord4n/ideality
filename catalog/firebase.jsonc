// Firebase CLI - built-in tool adapter manifest.
{
  "schemaVersion": 1,
  "kind": "tool",
  "id": "firebase",
  "displayName": "Firebase CLI",
  "pack": "deployment",
  "executable": {
    "primary": "firebase"
  },
  "isolation": {
    "scope": "process",
    "state": "full"
  },
  "auth": {
    "login": ["login"],
    "status": ["login:list"],
    "logout": ["logout"]
  },
  "profile": {
    "env": {
      "FIREBASE_TOKEN": {
        "from": "secret",
        "key": "{{identity}}/firebase-token",
        "optional": true
      },
      "XDG_CONFIG_HOME": "{{idealityHome}}/profiles/{{identity}}/deployment/firebase/config",
      "XDG_DATA_HOME": "{{idealityHome}}/profiles/{{identity}}/deployment/firebase/data",
      "XDG_STATE_HOME": "{{idealityHome}}/profiles/{{identity}}/deployment/firebase/state",
      "XDG_CACHE_HOME": "{{idealityHome}}/profiles/{{identity}}/deployment/firebase/cache"
    }
  }
}
