// Render CLI - built-in tool adapter manifest.
{
  "schemaVersion": 1,
  "kind": "tool",
  "id": "render",
  "displayName": "Render CLI",
  "pack": "deployment",
  "executable": {
    "primary": "render"
  },
  "isolation": {
    "scope": "process",
    "state": "credentials"
  },
  "profile": {
    "env": {
      "RENDER_API_KEY": {
        "from": "secret",
        "key": "{{identity}}/render-token",
        "optional": true
      },
      "XDG_CONFIG_HOME": "{{idealityHome}}/profiles/{{identity}}/deployment/render/config",
      "XDG_DATA_HOME": "{{idealityHome}}/profiles/{{identity}}/deployment/render/data",
      "XDG_STATE_HOME": "{{idealityHome}}/profiles/{{identity}}/deployment/render/state",
      "XDG_CACHE_HOME": "{{idealityHome}}/profiles/{{identity}}/deployment/render/cache"
    }
  }
}
