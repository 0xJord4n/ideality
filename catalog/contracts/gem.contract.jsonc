// RubyGems client - adapter behavior contract.
// catalog:check compiles catalog/gem.jsonc and fails when these
// expectations drift; keep the contract in lockstep with the manifest.
{
  "contractVersion": 1,
  "kind": "tool-contract",
  "tool": "gem",
  "detection": ["gem"],
  "profiles": [
    {
      "case": "default",
      "env": {
        "GEM_HOME": "{{idealityHome}}/profiles/{{identity}}/registries/rubygems/gems",
        "GEM_PATH": "{{idealityHome}}/profiles/{{identity}}/registries/rubygems/gems",
        "GEMRC": "{{idealityHome}}/profiles/{{identity}}/registries/rubygems/gemrc"
      }
    }
  ],
  "redactions": []
}
