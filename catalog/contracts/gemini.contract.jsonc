// Gemini CLI - adapter behavior contract.
// catalog:check compiles catalog/gemini.jsonc and fails when these
// expectations drift; keep the contract in lockstep with the manifest.
{
  "contractVersion": 1,
  "kind": "tool-contract",
  "tool": "gemini",
  "detection": ["gemini"],
  "profiles": [
    {
      "case": "default",
      "env": {
        "GEMINI_CLI_HOME": "{{idealityHome}}/profiles/{{identity}}/ai/gemini",
        "GEMINI_API_KEY": {
          "from": "secret",
          "key": "{{identity}}/gemini-api-key",
          "optional": true
        }
      }
    }
  ],
  "redactions": ["GEMINI_API_KEY"]
}
