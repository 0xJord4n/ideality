// OpenCode - adapter behavior contract.
// catalog:check compiles catalog/opencode.jsonc and fails when these
// expectations drift; keep the contract in lockstep with the manifest.
{
  "contractVersion": 1,
  "kind": "tool-contract",
  "tool": "opencode",
  "detection": ["opencode"],
  "auth": {
    "login": ["opencode", "auth", "login"],
    "status": ["opencode", "auth", "list"],
    "logout": ["opencode", "auth", "logout"]
  },
  "profiles": [
    {
      "case": "default",
      "env": {
        "XDG_CONFIG_HOME": "{{idealityHome}}/profiles/{{identity}}/opencode/config",
        "XDG_DATA_HOME": "{{idealityHome}}/profiles/{{identity}}/opencode/data",
        "XDG_STATE_HOME": "{{idealityHome}}/profiles/{{identity}}/opencode/state",
        "XDG_CACHE_HOME": "{{idealityHome}}/profiles/{{identity}}/opencode/cache"
      }
    }
  ],
  "redactions": []
}
