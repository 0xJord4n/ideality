// Supabase CLI - adapter behavior contract.
// catalog:check compiles catalog/supabase.jsonc and fails when these
// expectations drift; keep the contract in lockstep with the manifest.
{
  "contractVersion": 1,
  "kind": "tool-contract",
  "tool": "supabase",
  "detection": ["supabase"],
  "auth": {
    "login": ["supabase", "login"]
  },
  "profiles": [
    {
      "case": "default",
      "env": {
        "SUPABASE_ACCESS_TOKEN": {
          "from": "secret",
          "key": "{{identity}}/supabase-token",
          "optional": true
        },
        "XDG_CONFIG_HOME": "{{idealityHome}}/profiles/{{identity}}/deployment/supabase/config",
        "XDG_DATA_HOME": "{{idealityHome}}/profiles/{{identity}}/deployment/supabase/data",
        "XDG_STATE_HOME": "{{idealityHome}}/profiles/{{identity}}/deployment/supabase/state",
        "XDG_CACHE_HOME": "{{idealityHome}}/profiles/{{identity}}/deployment/supabase/cache"
      }
    }
  ],
  "redactions": ["SUPABASE_ACCESS_TOKEN"]
}
