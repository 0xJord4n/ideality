// Stripe CLI - adapter behavior contract.
// catalog:check compiles catalog/stripe.jsonc and fails when these
// expectations drift; keep the contract in lockstep with the manifest.
{
  "contractVersion": 1,
  "kind": "tool-contract",
  "tool": "stripe",
  "detection": ["stripe"],
  "auth": {
    "login": ["stripe", "login"],
    "status": ["stripe", "config", "--list"]
  },
  "profiles": [
    {
      "case": "default",
      "env": {
        "STRIPE_API_KEY": {
          "from": "secret",
          "key": "{{identity}}/stripe-api-key",
          "optional": true
        },
        "XDG_CONFIG_HOME": "{{idealityHome}}/profiles/{{identity}}/deployment/stripe/config",
        "XDG_DATA_HOME": "{{idealityHome}}/profiles/{{identity}}/deployment/stripe/data",
        "XDG_STATE_HOME": "{{idealityHome}}/profiles/{{identity}}/deployment/stripe/state",
        "XDG_CACHE_HOME": "{{idealityHome}}/profiles/{{identity}}/deployment/stripe/cache"
      }
    }
  ],
  // STRIPE_API_KEY resolves through the secret backend and must surface
  // redacted everywhere the environment is displayed.
  "redactions": ["STRIPE_API_KEY"]
}
