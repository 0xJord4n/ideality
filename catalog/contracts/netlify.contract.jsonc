// Netlify CLI - adapter behavior contract.
// catalog:check compiles catalog/netlify.jsonc and fails when these
// expectations drift; keep the contract in lockstep with the manifest.
{
  "contractVersion": 1,
  "kind": "tool-contract",
  "tool": "netlify",
  "detection": ["netlify"],
  "auth": {
    "login": ["netlify", "login"],
    "status": ["netlify", "status"],
    "logout": ["netlify", "logout"]
  },
  "profiles": [
    {
      "case": "default",
      "env": {
        "NETLIFY_AUTH_TOKEN": {
          "from": "secret",
          "key": "{{identity}}/netlify-token",
          "optional": true
        },
        "XDG_CONFIG_HOME": "{{idealityHome}}/profiles/{{identity}}/deployment/netlify/config",
        "XDG_DATA_HOME": "{{idealityHome}}/profiles/{{identity}}/deployment/netlify/data",
        "XDG_STATE_HOME": "{{idealityHome}}/profiles/{{identity}}/deployment/netlify/state",
        "XDG_CACHE_HOME": "{{idealityHome}}/profiles/{{identity}}/deployment/netlify/cache"
      }
    }
  ],
  "redactions": ["NETLIFY_AUTH_TOKEN"]
}
