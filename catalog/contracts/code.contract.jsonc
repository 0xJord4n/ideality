// Visual Studio Code - adapter behavior contract.
// catalog:check compiles catalog/code.jsonc and fails when these
// expectations drift; keep the contract in lockstep with the manifest.
{
  "contractVersion": 1,
  "kind": "tool-contract",
  "tool": "code",
  "detection": ["code", "code-insiders"],
  "profiles": [
    {
      "case": "default",
      "args": [
        "--user-data-dir",
        "{{idealityHome}}/profiles/{{identity}}/editors/vscode/user-data",
        "--extensions-dir",
        "{{idealityHome}}/profiles/{{identity}}/editors/vscode/extensions"
      ]
    }
  ],
  "redactions": []
}
