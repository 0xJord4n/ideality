// Fly.io CLI - adapter behavior contract.
// catalog:check compiles catalog/fly.jsonc and fails when these
// expectations drift; keep the contract in lockstep with the manifest.
{
  "contractVersion": 1,
  "kind": "tool-contract",
  "tool": "fly",
  "detection": ["fly", "flyctl"],
  "auth": {
    "login": ["fly", "auth", "login"],
    "status": ["fly", "auth", "whoami"],
    "logout": ["fly", "auth", "logout"]
  },
  "profiles": [
    {
      "case": "default",
      "env": {
        "FLY_API_TOKEN": {
          "from": "secret",
          "key": "{{identity}}/fly-token",
          "optional": true
        },
        "XDG_CONFIG_HOME": "{{idealityHome}}/profiles/{{identity}}/deployment/fly/config",
        "XDG_DATA_HOME": "{{idealityHome}}/profiles/{{identity}}/deployment/fly/data",
        "XDG_STATE_HOME": "{{idealityHome}}/profiles/{{identity}}/deployment/fly/state",
        "XDG_CACHE_HOME": "{{idealityHome}}/profiles/{{identity}}/deployment/fly/cache"
      }
    }
  ],
  "redactions": ["FLY_API_TOKEN"]
}
