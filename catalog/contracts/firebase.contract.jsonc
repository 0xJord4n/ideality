// Firebase CLI - adapter behavior contract.
// catalog:check compiles catalog/firebase.jsonc and fails when these
// expectations drift; keep the contract in lockstep with the manifest.
{
  "contractVersion": 1,
  "kind": "tool-contract",
  "tool": "firebase",
  "detection": ["firebase"],
  "auth": {
    "login": ["firebase", "login"],
    "status": ["firebase", "login:list"],
    "logout": ["firebase", "logout"]
  },
  "profiles": [
    {
      "case": "default",
      "env": {
        "FIREBASE_TOKEN": {
          "from": "secret",
          "key": "{{identity}}/firebase-token",
          "optional": true
        },
        "XDG_CONFIG_HOME": "{{idealityHome}}/profiles/{{identity}}/deployment/firebase/config",
        "XDG_DATA_HOME": "{{idealityHome}}/profiles/{{identity}}/deployment/firebase/data",
        "XDG_STATE_HOME": "{{idealityHome}}/profiles/{{identity}}/deployment/firebase/state",
        "XDG_CACHE_HOME": "{{idealityHome}}/profiles/{{identity}}/deployment/firebase/cache"
      }
    }
  ],
  "redactions": ["FIREBASE_TOKEN"]
}
