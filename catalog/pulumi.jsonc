// Pulumi CLI - built-in tool adapter manifest.
{
  "schemaVersion": 1,
  "kind": "tool",
  "id": "pulumi",
  "displayName": "Pulumi CLI",
  "pack": "deployment",
  "executable": {
    "primary": "pulumi"
  },
  "isolation": {
    "scope": "process",
    "state": "full"
  },
  "auth": {
    "login": ["login"],
    "status": ["whoami"],
    "logout": ["logout"]
  },
  "profile": {
    "env": {
      "PULUMI_HOME": "{{idealityHome}}/profiles/{{identity}}/deployment/pulumi",
      "PULUMI_ACCESS_TOKEN": {
        "from": "secret",
        "key": "{{identity}}/pulumi-token",
        "optional": true
      },
      "AWS_CONFIG_FILE": "{{idealityHome}}/profiles/{{identity}}/cloud/aws/config",
      "AWS_SHARED_CREDENTIALS_FILE": "{{idealityHome}}/profiles/{{identity}}/cloud/aws/credentials",
      "CLOUDSDK_CONFIG": "{{idealityHome}}/profiles/{{identity}}/cloud/gcloud",
      "AZURE_CONFIG_DIR": "{{idealityHome}}/profiles/{{identity}}/cloud/azure"
    }
  }
}
