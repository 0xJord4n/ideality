// PyCharm - built-in tool adapter manifest.
{
  "schemaVersion": 1,
  "kind": "tool",
  "id": "pycharm",
  "displayName": "PyCharm",
  "pack": "editors",
  "executable": {
    "primary": "pycharm"
  },
  "isolation": {
    "scope": "process",
    "state": "partial"
  },
  "profile": {
    "env": {
      "XDG_CONFIG_HOME": "{{idealityHome}}/profiles/{{identity}}/editors/jetbrains/pycharm/config",
      "XDG_DATA_HOME": "{{idealityHome}}/profiles/{{identity}}/editors/jetbrains/pycharm/data",
      "XDG_STATE_HOME": "{{idealityHome}}/profiles/{{identity}}/editors/jetbrains/pycharm/state",
      "XDG_CACHE_HOME": "{{idealityHome}}/profiles/{{identity}}/editors/jetbrains/pycharm/cache"
    }
  }
}
