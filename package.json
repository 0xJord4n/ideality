{
  "name": "ideality",
  "version": "0.1.0",
  "description": "Folder-based identity orchestration for developer tools",
  "license": "MIT",
  "author": "",
  "bin": {
    "ideality": "./src/index.ts"
  },
  "type": "module",
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bunli build",
    "build:all": "bunli build --targets all",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "catalog:new": "bun run scripts/catalog-new.ts",
    "catalog:check": "bun run scripts/catalog-check.ts",
    "catalog:docs": "bun run scripts/catalog-check.ts --write",
    "check": "bun run typecheck && bun run catalog:check && bun test"
  },
  "dependencies": {
    "@bunli/core": "0.9.1",
    "@bunli/utils": "0.6.0",
    "@opentui/core": "0.1.97",
    "@opentui/react": "0.1.97",
    "jsonc-parser": "^3.3.1",
    "react": "^19.2.8",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@bunli/test": "0.6.0",
    "@tsconfig/bun": "1.0.10",
    "@types/bun": "1.3.14",
    "@types/react": "^19.2.17",
    "bunli": "0.9.1",
    "typescript": "^5.9.3"
  }
}
